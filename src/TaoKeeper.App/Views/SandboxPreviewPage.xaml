<?xml version="1.0" encoding="utf-8"?>
<!--
    P13 先试后行（沙箱预演）：三出口（留下/丢弃/转正式快照）+ 越界拒绝并记录逐条展开（R-P13-4）。
    未预演=未测态零预填（V-A10）；越界 0 次如实显示 0；写穿零发生（W3）真机验证项。
    入口：清理/修复动作旁（R-P13-1），不入侧栏导航（V-A6 侧栏恒 7 项/12 项导航条不动）。
-->
<Page
    x:Class="TaoKeeper.App.Views.SandboxPreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="980" Padding="28,20,28,30" Spacing="14">
            <TextBlock Text="场景入口" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}" />
            <TextBlock Text="先试后行" FontSize="26" FontWeight="SemiBold"
                       Foreground="{ThemeResource TaoInkBrush}" />
            <TextBlock Text="清理或修复前先在预演里走一遍：动什么、拦什么先看清楚，再决定留下还是丢弃"
                       FontSize="13.5" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="BeginButton" Content="开始预演" Click="OnBegin"
                        CornerRadius="10" Padding="22,9" Style="{StaticResource TaoButtonPrimary}" />
                <Button x:Name="CommitButton" Content="留下（正式执行）" Click="OnCommit"
                        CornerRadius="10" Padding="22,9" Style="{StaticResource TaoButtonGhost}" />
                <Button x:Name="DiscardButton" Content="丢弃" Click="OnDiscard"
                        CornerRadius="10" Padding="22,9" Style="{StaticResource TaoButtonGhost}" />
                <Button x:Name="FreezeButton" Content="转正式快照" Click="OnFreeze"
                        CornerRadius="10" Padding="22,9" Style="{StaticResource TaoButtonGhost}" />
                <ProgressRing x:Name="RunRing" Width="22" Height="22" Visibility="Collapsed" />
            </StackPanel>

            <!-- 越界拒绝并记录：逐条展开（时间+目标路径+拦截原因），永不静默 -->
            <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}"
                    Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ViolationHeader" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{ThemeResource TaoInkBrush}"
                               Text="越界拦截 0 次（如实显示，宁误拦不写穿）" />
                    <TextBlock x:Name="EmptyLine" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TaoInk3Brush}"
                               Text="未开始预演：点「开始预演」后所有写入先走沙箱，越界写入会被拒绝并记录在这里。" />
                    <ItemsControl x:Name="InterceptionList" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{ThemeResource TaoInk3Brush}"
                               Text="确认执行前自动拍快照（可在时光回溯页还原）；「留下」才正式执行，「丢弃」零残留，「转正式快照」原样冻结。" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ResultLine" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource TaoInk2Brush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
