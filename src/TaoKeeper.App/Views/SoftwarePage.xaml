<?xml version="1.0" encoding="utf-8"?>
<!--
    软件管家页（按需求稿 R-P2-14 落位）：
    页头三行 + 安全承诺条 + 四功能页签（软件库/升级中心/卸载中心/安全承诺）。
    G7（老板 2026-11-13 14:15 拍板）：来源统一收后台——三来源条已撤下，
    页头只留一句安全承诺语，不列渠道名；来源/哈希等安全校验细节全部后台完成，用户零感知。
    数据经 SoftwarePageViewModel（升级三分桶）；已装清单经 InstalledListProvider 钩子注入
    （未接线时如实显示「尚未扫描」，不假数据）。安装/升级/卸载动作全部经确认闸门。
-->
<Page
    x:Class="TaoKeeper.App.Views.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="980" Padding="28,20,28,30" Spacing="14">
            <TextBlock Text="软件管家 · 装机升级行家" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}" />
            <TextBlock Text="软件管家" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}" />
            <TextBlock Text="装、升、卸，一条龙；官方渠道、装前校验，全程自动择优，不用你挑" FontSize="13.5"
                       Foreground="{ThemeResource TaoInk2Brush}" />

            <!-- 安全承诺条（R-P2-14：原三来源条收简，不列渠道名；圆角 10px、衬线 16px、azure-wash 底+azure-deep 字） -->
            <Border CornerRadius="10" Padding="16,10"
                    Background="{ThemeResource TaoAzureWashBrush}">
                <TextBlock Text="只走官方渠道，装前逐包校验；哪条路快走哪条，你只管点，剩下的交给我们。"
                           FontSize="16" FontFamily="Segoe UI"
                           Foreground="{ThemeResource TaoAzureDeepBrush}" TextWrapping="Wrap" />
            </Border>

            <!-- 功能页签 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TabStore" Content="软件库" Click="OnTabClick" Tag="store"
                        CornerRadius="10" Padding="14,7" />
                <Button x:Name="TabUpgrade" Content="升级中心" Click="OnTabClick" Tag="upgrade"
                        CornerRadius="10" Padding="14,7" />
                <Button x:Name="TabUninstall" Content="卸载中心" Click="OnTabClick" Tag="uninstall"
                        CornerRadius="10" Padding="14,7" />
                <Button x:Name="TabPledge" Content="安全承诺" Click="OnTabClick" Tag="pledge"
                        CornerRadius="10" Padding="14,7" />
            </StackPanel>

            <!-- 软件库 -->
            <StackPanel x:Name="PaneStore" Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StoreSearchBox" Grid.Column="0" PlaceholderText="搜软件名，如：微信、VS Code、7-Zip…"
                             CornerRadius="10" />
                    <Button Grid.Column="1" Content="搜一下" Click="OnStoreSearch" CornerRadius="10" Padding="16,7"
                            Style="{StaticResource TaoButtonPrimary}" />
                </Grid>

                <Border CornerRadius="12" BorderThickness="1" Padding="14,10"
                        BorderBrush="{ThemeResource TaoAzureBrush}" Background="{ThemeResource TaoAzureWashBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="默认安装位置 D:\TaoKeeper\Soft" FontSize="13.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock Text="静默安装一律默认 D 盘，不往 C 盘塞；每款软件安装前可单独改位置，全局默认目录也随时能自定义。"
                                   FontSize="12" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TaoInk2Brush}" />
                    </StackPanel>
                </Border>

                <!-- R-P2-9：12 类齐全，ItemsWrapGrid 横向换行（页签在 code-behind 生成，选中态高亮） -->
                <ItemsControl x:Name="CategoryTabs">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="100" ItemHeight="40"
                                           HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- R-P2-8：库容量行——如实标注精选示例收录量 + 愿望单入口（真按钮，点开愿望单弹层） -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="StoreCapacityText" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource TaoInk2Brush}" />
                    <Button x:Name="WishlistButton" Content="愿望单" Click="OnWishlistClick"
                            CornerRadius="10" Padding="14,6" />
                </StackPanel>

                <TextBlock x:Name="StoreHint" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}"
                           Text="下方为精选示例卡；也可以直接搜软件名安装，已装清单见列表。" />
                <!-- R-P2-8：16 张精选示例卡 2-3 列自适（code-behind 生成，统一「精选示例」标注） -->
                <ItemsControl x:Name="StoreCardGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="286" ItemHeight="118"
                                           HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="StoreFooter" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}"
                           Text="以上为精选示例 · 接入后以实际收录量在此如实标注" />

                <TextBlock Text="已装软件" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{ThemeResource TaoInkBrush}" />
                <ItemsControl x:Name="StoreList" />
            </StackPanel>

            <!-- 升级中心 -->
            <StackPanel x:Name="PaneUpgrade" Spacing="12" Visibility="Collapsed">
                <TextBlock x:Name="UpgradeSummary" FontSize="13.5" Foreground="{ThemeResource TaoInk2Brush}" />
                <TextBlock x:Name="BlockedHint" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TaoCinnabarBrush}" Visibility="Collapsed" />
                <!-- R-P2-2：三分桶——可静默 / 需你确认 / 已拦截，各组带计数 pill（随实数刷新，空组显空态） -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="可静默升级" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource TaoInkBrush}" />
                    <Border x:Name="SilentPill" CornerRadius="9" Background="{ThemeResource TaoAzureWashBrush}"
                            Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="SilentPillText" Text="0" FontSize="12" Foreground="{ThemeResource TaoAzureDeepBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SilentEmpty" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TaoInk3Brush}"
                           Text="没有可静默升级的软件——有更新时会出现在这里。" />
                <ItemsControl x:Name="SilentList" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="需你确认的升级（逐项过目，默认不静默）" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource TaoInkBrush}" />
                    <Border x:Name="ConfirmPill" CornerRadius="9" Background="{ThemeResource TaoAzureWashBrush}"
                            Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="ConfirmPillText" Text="0" FontSize="12" Foreground="{ThemeResource TaoAzureDeepBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="ConfirmEmpty" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TaoInk3Brush}"
                           Text="没有待确认的升级——软件都是最新的。" />
                <ItemsControl x:Name="UpgradeList" />
                <StackPanel x:Name="BlockedPane" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="已拦截" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource TaoCinnabarBrush}" />
                    <Border CornerRadius="9" Background="{ThemeResource TaoCinnabarWashBrush}"
                            Padding="10,3" VerticalAlignment="Center">
                        <TextBlock x:Name="BlockedPillText" Text="0" FontSize="12" Foreground="{ThemeResource TaoCinnabarBrush}" />
                    </Border>
                </StackPanel>
                <ItemsControl x:Name="BlockedList" />
                <TextBlock Text="每条升级装前都会自动过安全校验；校验没过的根本进不了清单，不用你操心。"
                           FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk3Brush}" />
            </StackPanel>

            <!-- 卸载中心 -->
            <StackPanel x:Name="PaneUninstall" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="卸载走系统正规入口，不做进程强杀；每一步都先经你确认。" FontSize="12"
                           TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                <!-- R-4/C3：空态全覆盖——未扫描/无已装软件有明确反馈，不装死 -->
                <TextBlock x:Name="UninstallEmpty" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TaoInk3Brush}"
                           Text="还没扫到已装软件。扫描接线后这里逐行列出，卸载前先经你确认。" />
                <ItemsControl x:Name="UninstallList" />
            </StackPanel>

            <!-- 安全承诺 -->
            <Border x:Name="PanePledge" CornerRadius="14" BorderThickness="1" Padding="18,14"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}" Background="{ThemeResource TaoCardBrush}"
                    Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="安全承诺" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}" />
                    <TextBlock FontSize="12" LineHeight="22" TextWrapping="Wrap"
                               Foreground="{ThemeResource TaoInk2Brush}"
                               Text="只装官方源软件，装前哈希校验、装后可回溯；不捆绑、不装全家桶、不静默装软件；每笔安装记入安装账，随时可查可卸。默认安装位置 D:\TaoKeeper\Soft，不往 C 盘塞。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
