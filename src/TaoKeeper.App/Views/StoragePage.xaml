<?xml version="1.0" encoding="utf-8"?>
<!--
    存储感知页（最小可用形态，布局严格按原型 v19：总开关卡 + 逐项勾选卡 + 回收站语义注脚）。
    注：原型示例行（浏览器缓存/系统临时文件/缩略图缓存）为示意样张；实际逐项渲染引擎真实四范围
    （临时文件/回收站过期项/下载目录滞留件/浏览器缓存），布局与卡片结构不变、文案如实。
    数据经 StorageSensePageViewModel 注入：本层零写动作，到点只出确认预览，绝不静默清理。
-->
<Page
    x:Class="TaoKeeper.App.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaoKeeper.App.Views">

    <ScrollViewer>
        <StackPanel MaxWidth="760" Padding="28,22,28,30" Spacing="14" HorizontalAlignment="Left">
            <TextBlock Text="存储感知" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}" />
            <TextBlock Text="存储感知" FontSize="26" FontWeight="SemiBold"
                       Foreground="{ThemeResource TaoInkBrush}" />
            <TextBlock Text="到点只出确认预览，绝不静默清理；默认关，由你打开" FontSize="13.5"
                       Foreground="{ThemeResource TaoInk2Brush}" />

            <!-- 总开关卡 -->
            <Border CornerRadius="14" BorderThickness="1" Padding="18,14" Margin="0,6,0,0"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}"
                    Background="{ThemeResource TaoCardBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="定时自动清理" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TaoInk3Brush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MasterSwitch" Grid.Column="1" VerticalAlignment="Center"
                                  OnContent="" OffContent="" Margin="0,0,0,0"
                                  Toggled="OnMasterToggled" />
                </Grid>
            </Border>

            <!-- 逐项勾选卡 -->
            <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}"
                    Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="纳入清理的项目（逐项勾选）" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TaoInkBrush}" />
                    <ItemsControl x:Name="ScopeList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:StorageScopeRow">
                                <Grid ColumnSpacing="10" Padding="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" MinWidth="0" IsChecked="{x:Bind IsOn, Mode=OneTime}"
                                              IsEnabled="{x:Bind CanToggle, Mode=OneTime}"
                                              Checked="OnScopeToggle" Unchecked="OnScopeToggle" Tag="{x:Bind Flag}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TaoInkBrush}" />
                                        <TextBlock Text="{x:Bind Meta}" FontSize="12"
                                                   Foreground="{ThemeResource TaoInk3Brush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ScopeError" FontSize="12.5" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{ThemeResource TaoCinnabarBrush}" />
                    <TextBlock FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{ThemeResource TaoInk3Brush}"
                               Text="所有清理动作走回收站语义：先确认、先进回收站、可还原。" />
                </StackPanel>
            </Border>

            <!-- 闭环演示卡：感知（到点判定）→ 提示（确认预览）→ 确认 → 执行（回收站语义） -->
            <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}"
                    Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="到点检查与确认执行" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource TaoInkBrush}" />
                    <Button x:Name="CheckNowButton" Content="立即检查一次（到点才提示，未到点不动任何文件）"
                            Click="OnCheckNowClick" CornerRadius="10" Padding="14,7" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CheckResult" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{ThemeResource TaoInk2Brush}"
                               Text="开启后到点会在这里给出确认预览；未到点不做任何事。" />
                    <StackPanel x:Name="PendingActions" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                        <Button x:Name="ConfirmRunButton" Content="确认清理（进回收站，可还原）"
                                Style="{StaticResource AccentButtonStyle}" Click="OnConfirmRunClick"
                                CornerRadius="10" />
                        <Button x:Name="SkipRunButton" Content="这次先不清" Click="OnSkipRunClick"
                                CornerRadius="10" />
                    </StackPanel>
                    <TextBlock FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TaoInk3Brush}"
                               Text="与手动清理不冲突：到点只提示你确认，不会碰磁盘清理页正在处理的清单；两边执行都走同一回收站语义与清理账。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
