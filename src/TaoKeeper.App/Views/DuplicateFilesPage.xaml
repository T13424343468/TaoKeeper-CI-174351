<?xml version="1.0" encoding="utf-8"?>
<!--
    重复文件页（原型 v19 工具箱项「重复文件 · 三级漏斗识别，零误报才报」的单页落地，沿用 v19 卡片设计语言）。
    数据经 DuplicateFilesPageViewModel 注入：仅全文件 SHA-256 完全相同才判重复（零误报）；
    每组保留一份、其余默认列为待清理；保留选择组内单选（VM.TrySetKeep，无效选择不动作）。
    「转入确认队列」只产出经 CleanupSafetyGate 闸门的清单（受保护路径从源头标死），
    实际执行由 CleanupCoordinator 接线（P2），本页零写动作。
-->
<Page
    x:Class="TaoKeeper.App.Views.DuplicateFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="980" Padding="28,20,28,30" Spacing="14">
            <TextBlock Text="工具箱 · 重复文件" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}" />
            <TextBlock Text="重复文件" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}" />
            <TextBlock Text="三级漏斗识别，零误报才报——每组保留一份，其余先进回收站" FontSize="13.5"
                       Foreground="{ThemeResource TaoInk2Brush}" />

            <!-- 概览卡 -->
            <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}" Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                Background="{ThemeResource TaoGoldBrush}" />
                        <TextBlock x:Name="SummaryText" FontSize="13.5" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TaoInkBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyHint" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{ThemeResource TaoInk3Brush}"
                               Text="尚未扫描。重复文件扫描接线后，各组在这里按可释放体积降序排列（全文件哈希相同才算重复，零误报）。" />
                </StackPanel>
            </Border>

            <!-- 分组明细 -->
            <ItemsControl x:Name="GroupList" />

            <!-- 汇总与转入 -->
            <Border x:Name="TotalCard" CornerRadius="14" BorderThickness="1" Padding="18,14" Visibility="Collapsed"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}" Background="{ThemeResource TaoCardBrush}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalText" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TaoInk3Brush}"
                                   Text="待清理份默认排除组内保留份；受保护路径/盘符根由安全闸门在源头标死，勾不上也执行不了。" />
                    </StackPanel>
                    <Button x:Name="QueueButton" Grid.Column="1" Content="转入确认队列（先进回收站）"
                            Click="OnQueueClick" CornerRadius="10" Padding="16,7" VerticalAlignment="Center"
                            Background="{ThemeResource TaoAzureBrush}" Foreground="White" />
                </Grid>
            </Border>

            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk3Brush}"
                       Text="本页只做选择与确认：真正的清理动作先进回收站，可在回收站还原；改选保留份不会动任何文件。" />
        </StackPanel>
    </ScrollViewer>
</Page>
