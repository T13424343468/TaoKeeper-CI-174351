<?xml version="1.0" encoding="utf-8"?>
<!--
    启动项页（只读展示骨架）：清单按真实来源列出，风险与状态如实呈现；
    本页零写动作——启用/禁用统一走性能加速页的确认闸门，本页只看不动。
    数据经 StartupPageViewModel（未扫描态如实显示，不假数据）。
-->
<Page
    x:Class="TaoKeeper.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="980" Padding="28,20,28,30" Spacing="14">
            <TextBlock Text="启动项" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}" />
            <TextBlock Text="启动项" FontSize="26" FontWeight="SemiBold"
                       Foreground="{ThemeResource TaoInkBrush}" />
            <TextBlock Text="只看不动：清单如实列出，启用与禁用走性能加速页的确认闸门" FontSize="13.5"
                       Foreground="{ThemeResource TaoInk2Brush}" />

            <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}"
                    Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="SummaryLine" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{ThemeResource TaoInkBrush}" />
                    <TextBlock x:Name="EmptyLine" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{ThemeResource TaoInk3Brush}"
                               Text="尚未扫描启动项（等待运行期接线；不假数据）。" />
                    <ItemsControl x:Name="ItemList" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{ThemeResource TaoInk3Brush}"
                               Text="本页仅只读展示：不提供开关，不做任何系统改动；逐条启停请在性能加速页确认后执行。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
