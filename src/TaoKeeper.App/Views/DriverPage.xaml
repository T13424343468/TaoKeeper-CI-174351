<?xml version="1.0" encoding="utf-8"?>
<!--
    驱动升级页（严格按原型 v19 data-page="driver"）：
    页头 + 清册表（设备/当前版本/可用版本/来源/动作）+ 合规脚注。
    数据经 DriverPageViewModel（清册含已是最新行；升级动作三道闸：备份→逐项确认→执行；
    哈希失配标死；未确认零写动作）。
-->
<Page
    x:Class="TaoKeeper.App.Views.DriverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="980" Padding="28,20,28,30" Spacing="14">
            <TextBlock Text="驱动升级" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}" />
            <TextBlock Text="驱动升级" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}" />
            <TextBlock Text="只装官方驱动，装前备份、随时回滚" FontSize="13.5"
                       Foreground="{ThemeResource TaoInk2Brush}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="SummaryText" FontSize="13.5" VerticalAlignment="Center"
                           Foreground="{ThemeResource TaoInk2Brush}" Text="尚未扫描驱动清单" />
                <Button x:Name="ScanButton" Content="扫描驱动" Click="OnScanClick" CornerRadius="10"
                        Padding="16,7" Style="{StaticResource TaoButtonPrimary}" />
            </StackPanel>

            <Border CornerRadius="14" BorderThickness="1" Padding="16,12"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}" Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="10">
                    <!-- 表头（Grid 模拟表格，原型 .tbl 五列） -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="设备" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TaoInk3Brush}" />
                        <TextBlock Grid.Column="1" Text="当前版本" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TaoInk3Brush}" />
                        <TextBlock Grid.Column="2" Text="可用版本" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TaoInk3Brush}" />
                        <TextBlock Grid.Column="3" Text="来源" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TaoInk3Brush}" />
                        <TextBlock Grid.Column="4" Text="" FontSize="12" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource TaoLineSoftBrush}" HorizontalAlignment="Stretch" />
                    <ItemsControl x:Name="DriverRows" />
                </StackPanel>
            </Border>

            <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{ThemeResource TaoInk3Brush}"
                       Text="不装第三方改版驱动；每次升级前自动备份当前驱动，出问题一键回滚。高危设备（显卡/芯片组/存储/网络）必须逐项确认，哈希失配的驱动包一律拒绝安装。" />
        </StackPanel>
    </ScrollViewer>
</Page>
