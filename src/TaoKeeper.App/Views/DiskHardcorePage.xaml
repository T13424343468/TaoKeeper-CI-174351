<?xml version="1.0" encoding="utf-8"?>
<!--
    P-6 硬核四项：恢复前镜像/RAW 深扫+分区表重建（镜像上）、内存坏页定位（只标记不改引导 D3）、
    坏道扫描标记（标记写盘须确认 D4）。只读默认，写入类操作显式确认；源盘零写入（D1）。
    诚实口径 N9：扫不出=显式提示，不打包票。入口：工具箱误删恢复卡（R-P10-5），不入侧栏导航（V-A6）。
-->
<Page
    x:Class="TaoKeeper.App.Views.DiskHardcorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="980" Padding="28,20,28,30" Spacing="14">
            <TextBlock Text="场景入口" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}" />
            <TextBlock Text="数据找回与硬盘诊断" FontSize="26" FontWeight="SemiBold"
                       Foreground="{ThemeResource TaoInkBrush}" />
            <TextBlock Text="先给源盘拍镜像再动手：扫描全程只读，写入类操作（重建、标记）都要你二次确认"
                       FontSize="13.5" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="ScanButton" Content="建镜像并扫描" Click="OnScan"
                        CornerRadius="10" Padding="22,9" Style="{StaticResource TaoButtonPrimary}" />
                <Button x:Name="RebuildButton" Content="在镜像上重建分区表" Click="OnRebuild"
                        CornerRadius="10" Padding="22,9" Style="{StaticResource TaoButtonGhost}" />
                <Button x:Name="MarkButton" Content="标记坏道" Click="OnMark"
                        CornerRadius="10" Padding="22,9" Style="{StaticResource TaoButtonGhost}" />
            </StackPanel>

            <TextBlock x:Name="EmptyLine" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource TaoInk3Brush}"
                       Text="尚未扫描：点「建镜像并扫描」后在本机镜像上出结果（源盘零写入）。" />

            <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}"
                    Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}"
                               Text="诊断报告" />
                    <ItemsControl x:Name="RowList" />
                </StackPanel>
            </Border>

            <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}"
                    Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}"
                               Text="可恢复文件（以实扫为准，不打包票）" />
                    <ItemsControl x:Name="FileList" />
                </StackPanel>
            </Border>

            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk3Brush}"
                       Text="本页全部在本机完成，不上传任何数据；被覆盖的数据真的没有了，能救多少以扫描为准（诚实口径）。" />
        </StackPanel>
    </ScrollViewer>
</Page>
