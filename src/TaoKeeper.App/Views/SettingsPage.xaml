<?xml version="1.0" encoding="utf-8"?>
<!--
    设置页（严格按原型 v19 data-page="settings"：crumb/标题/副题 + 六卡两栏）。
    数据经 SettingsPageViewModel 注入：默认零写动作——开关/主题/阈值改动先进待确认副本，
    点底部「保存改动」才经既有 AppSettingsStore 落盘（未接线存储时如实标明仅本会话生效）。
    红线锁定三项（三层官方软件源 / 装前哈希校验 / 清理先进回收站）以朱砂 pill 呈现，页面零写。
-->
<Page
    x:Class="TaoKeeper.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="980" Padding="28,20,28,30" Spacing="14">
            <TextBlock Text="设置" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}" />
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"
                       Foreground="{ThemeResource TaoInkBrush}" />
            <TextBlock Text="常用设置都归好类，常用的就在手边" FontSize="13.5"
                       Foreground="{ThemeResource TaoInk2Brush}" />

            <!-- R-4/W5：两列设置卡窄窗折叠单列——窄窗不再横向裁切 -->
            <Grid x:Name="DuoGrid" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DuoColA" Width="*" />
                    <ColumnDefinition x:Name="DuoColB" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1140" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="DuoColB.Width" Value="0" />
                                <Setter Target="DuoGrid.ColumnSpacing" Value="0" />
                                <Setter Target="SettingsRight.(Grid.Column)" Value="0" />
                                <Setter Target="SettingsRight.(Grid.Row)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <!-- 左栏：通用 / 软件管家 -->
                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="14">

                    <!-- 通用 -->
                    <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                            BorderBrush="{ThemeResource TaoLineSoftBrush}"
                            Background="{ThemeResource TaoCardBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="通用" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TaoInkBrush}" />
                            <TextBlock Text="界面主题 · 全局即时生效" FontSize="12"
                                       Foreground="{ThemeResource TaoInk2Brush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ThemeShuimo" Content="水墨" Click="OnThemeClick" CornerRadius="10" Padding="16,5" />
                                <Button x:Name="ThemeTianqing" Content="天青" Click="OnThemeClick" CornerRadius="10" Padding="16,5" />
                                <Button x:Name="ThemeMobai" Content="墨白" Click="OnThemeClick" CornerRadius="10" Padding="16,5" />
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="开机自动启动" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="随 Windows 启动，常驻极轻" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LaunchSwitch" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="OnLaunchToggled" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="开机后自动体检" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="静默跑一遍，只报变化不刷屏" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoCheckupSwitch" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="OnAutoCheckupToggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 托盘（R-P12-9）：开机自启+托盘常驻，保存后经 TrayIconController 即时生效 -->
                    <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                            BorderBrush="{ThemeResource TaoLineSoftBrush}"
                            Background="{ThemeResource TaoCardBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="托盘" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TaoInkBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="开机自启" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="与托盘菜单「开机自启」同源" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="TrayAutostartSwitch" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="OnTrayAutostartToggled" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="托盘常驻" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="关闭主窗口后仍保留托盘图标，不勾则随窗口退出" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="TrayResidentSwitch" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="OnTrayResidentToggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 软件管家 -->
                    <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                            BorderBrush="{ThemeResource TaoLineSoftBrush}"
                            Background="{ThemeResource TaoCardBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="软件管家" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TaoInkBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="默认安装位置" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock x:Name="InstallDirText" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox x:Name="InstallDirInput" MinWidth="220" PlaceholderText="输入新位置（每款软件装前可单独改）" />
                                        <Button x:Name="InstallDirEdit" Content="改位置" VerticalAlignment="Center"
                                                Click="OnStageInstallDir" CornerRadius="10" Padding="14,4" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="静默升级" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="默认关 · 开启后仅「可静默」类自动升级" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="SilentUpgradeSwitch" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="OnSilentUpgradeToggled" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="装完自动建桌面快捷方式" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="默认开 · 也可装完再选" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShortcutSwitch" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="OnShortcutToggled" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="装完记入安装账" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="默认开 · 每笔可回溯" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LedgerSwitch" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="OnLedgerToggled" />
                            </Grid>
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TaoInk3Brush}"
                                       Text="忽略版本管理：不想跟的升级点「忽略此版」，只跳单版（管理入口随运行期接线，本页不代管）。" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="三层官方软件源" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="winget / GitHub / 官网直链" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="9" Background="{ThemeResource TaoCinnabarWashBrush}"
                                        Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="红线锁定" FontSize="12"
                                               Foreground="{ThemeResource TaoCinnabarBrush}" />
                                </Border>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="装前哈希校验" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="逐包校验，失配即拦" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="9" Background="{ThemeResource TaoCinnabarWashBrush}"
                                        Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="红线锁定" FontSize="12"
                                               Foreground="{ThemeResource TaoCinnabarBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右栏：清理与存储 / 提醒与阈值 / 桌面挂件 / 其他 -->
                <StackPanel x:Name="SettingsRight" Grid.Column="1" Grid.Row="0" Spacing="14">

                    <!-- 清理与存储 -->
                    <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                            BorderBrush="{ThemeResource TaoLineSoftBrush}"
                            Background="{ThemeResource TaoCardBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="清理与存储" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TaoInkBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="清理先进回收站" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="一切清理都可还原" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="9" Background="{ThemeResource TaoCinnabarWashBrush}"
                                        Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="红线锁定" FontSize="12"
                                               Foreground="{ThemeResource TaoCinnabarBrush}" />
                                </Border>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="存储感知定时清理" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="默认关 · 到点只出确认预览" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StorageSenseSwitch" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="OnStorageSenseToggled" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="快扫默认开启" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="打开磁盘清理即快扫" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="QuickScanSwitch" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="OnQuickScanToggled" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 提醒与阈值 -->
                    <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                            BorderBrush="{ThemeResource TaoLineSoftBrush}"
                            Background="{ThemeResource TaoCardBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="提醒与阈值" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TaoInkBrush}" />
                            <TextBlock x:Name="MemoryAlertText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TaoInk2Brush}" />
                            <TextBlock x:Name="DiskFreeAlertText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TaoInk2Brush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MemoryAlertInput" Grid.Column="0" PlaceholderText="内存告警线，0–100（0=不提醒）" />
                                <Button x:Name="MemoryAlertEdit" Grid.Column="1" Content="改阈值" VerticalAlignment="Center"
                                        Click="OnStageMemoryAlert" CornerRadius="10" Padding="14,4" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DiskFreeInput" Grid.Column="0" PlaceholderText="磁盘余量提醒，0–1024 GB（0=不提醒）" />
                                <Button x:Name="DiskFreeEdit" Grid.Column="1" Content="改阈值" VerticalAlignment="Center"
                                        Click="OnStageDiskFree" CornerRadius="10" Padding="14,4" />
                            </Grid>
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TaoInk3Brush}"
                                       Text="六维逐项可关，分数只算你在乎的；通知分级：弹气泡 / 只记清理账，逐类勾选，默认安静（勾选入口随运行期接线）。" />
                            <TextBlock x:Name="ThresholdError" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{ThemeResource TaoCinnabarBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 桌面挂件 -->
                    <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                            BorderBrush="{ThemeResource TaoLineSoftBrush}"
                            Background="{ThemeResource TaoCardBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="桌面挂件" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TaoInkBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="显示桌面挂件" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Text="关闭即零后台残留，自启同步注销" FontSize="12"
                                               Foreground="{ThemeResource TaoInk3Brush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="WidgetSwitch" Grid.Column="1" VerticalAlignment="Center"
                                              OnContent="" OffContent="" Toggled="OnWidgetToggled" />
                            </Grid>
                            <TextBlock Text="显示内容 · 想看哪样勾哪样" FontSize="12"
                                       Foreground="{ThemeResource TaoInk2Brush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ContentMemory" Content="内存" Click="OnWidgetContentClick" CornerRadius="10" Padding="14,4" />
                                <Button x:Name="ContentJunkPending" Content="垃圾待清" Click="OnWidgetContentClick" CornerRadius="10" Padding="14,4" />
                                <Button x:Name="ContentDiskFree" Content="磁盘余量" Click="OnWidgetContentClick" CornerRadius="10" Padding="14,4" />
                            </StackPanel>
                            <TextBlock Text="挂件大小 · 两档 · 位置随手拖动" FontSize="12"
                                       Foreground="{ThemeResource TaoInk2Brush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SizeStandard" Content="标准" Click="OnWidgetSizeClick" CornerRadius="10" Padding="14,4" />
                                <Button x:Name="SizeCompact" Content="紧凑" Click="OnWidgetSizeClick" CornerRadius="10" Padding="14,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 其他 -->
                    <Border CornerRadius="14" BorderThickness="1" Padding="18,14"
                            BorderBrush="{ThemeResource TaoLineSoftBrush}"
                            Background="{ThemeResource TaoCardBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="其他" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TaoInkBrush}" />
                            <TextBlock x:Name="EntryHint" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TaoInk3Brush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PopupEntry" Content="弹窗管理 · 去管理" Click="OnPopupEntryClick" CornerRadius="10" Padding="14,4" />
                            </StackPanel>
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TaoInk3Brush}"
                                       Text="检查更新与导出日志入口随运行期接线，本页不代检不代导，如实空置。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 确认条：默认零写动作，有改动才出现 -->
            <Border x:Name="PendingBar" CornerRadius="12" BorderThickness="1" Padding="16,10"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}"
                    Background="{ThemeResource TaoAzureWashBrush}" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PendingSummary" Grid.Column="0" FontSize="12" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{ThemeResource TaoInk2Brush}" />
                    <Button x:Name="SaveButton" Grid.Column="1" Content="保存改动" Click="OnSaveClick"
                            CornerRadius="10" Padding="16,6"
                            Style="{StaticResource TaoButtonPrimary}" />
                    <Button x:Name="DiscardButton" Grid.Column="2" Content="放弃" Click="OnDiscardClick"
                            CornerRadius="10" Padding="14,6" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
