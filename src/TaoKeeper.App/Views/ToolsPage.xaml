<?xml version="1.0" encoding="utf-8"?>
<!--
    工具箱页（严格按原型 v19：8 张快捷卡，布局与文案不动）。
    大文件查找/磁盘空间分析/重复文件 三张卡点击展开结果区（数据经既有 VM 注入，
    未扫描如实显示「尚未扫描」）；其余工具卡点击如实提示随运行期接线启用。
-->
<Page
    x:Class="TaoKeeper.App.Views.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaoKeeper.App.Views">

    <ScrollViewer>
        <StackPanel MaxWidth="980" Padding="28,20,28,30" Spacing="14">
            <TextBlock Text="工具箱" FontSize="12" Foreground="{ThemeResource TaoInk3Brush}" />
            <TextBlock Text="工具箱" FontSize="26" FontWeight="SemiBold"
                       Foreground="{ThemeResource TaoInkBrush}" />
            <TextBlock Text="常备小工具，用完即走" FontSize="13.5"
                       Foreground="{ThemeResource TaoInk2Brush}" />

            <!-- 8 张快捷卡（4 列 × 2 行，顺序=原型） -->
            <Grid ColumnSpacing="12" RowSpacing="12" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="ToolLarge" Grid.Row="0" Grid.Column="0" Click="OnToolClick" Tag="large"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12"
                        CornerRadius="12" Background="{ThemeResource TaoCardBrush}"
                        BorderBrush="{ThemeResource TaoLineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="大文件查找" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock Text="扫描全盘大文件，哈希核对后处理" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ToolDup" Grid.Row="0" Grid.Column="1" Click="OnToolClick" Tag="dup"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12"
                        CornerRadius="12" Background="{ThemeResource TaoCardBrush}"
                        BorderBrush="{ThemeResource TaoLineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="重复文件" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock Text="三级漏斗识别，零误报才报" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ToolSimilar" Grid.Row="0" Grid.Column="2" Click="OnToolClick" Tag="similar"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12"
                        CornerRadius="12" Background="{ThemeResource TaoCardBrush}"
                        BorderBrush="{ThemeResource TaoLineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="相似图片" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock Text="重复照片一键归拢" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ToolCtxMenu" Grid.Row="0" Grid.Column="3" Click="OnToolClick" Tag="ctxmenu"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12"
                        CornerRadius="12" Background="{ThemeResource TaoCardBrush}"
                        BorderBrush="{ThemeResource TaoLineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="右键菜单管理" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock Text="过长菜单精简" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    </StackPanel>
                </Button>

                <Button x:Name="ToolShred" Grid.Row="1" Grid.Column="0" Click="OnToolClick" Tag="shred"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12"
                        CornerRadius="12" Background="{ThemeResource TaoCardBrush}"
                        BorderBrush="{ThemeResource TaoLineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="文件粉碎" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock Text="彻底删除，不可恢复（需确认）" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ToolProc" Grid.Row="1" Grid.Column="1" Click="OnToolClick" Tag="proc"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12"
                        CornerRadius="12" Background="{ThemeResource TaoCardBrush}"
                        BorderBrush="{ThemeResource TaoLineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="进程管理" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock Text="详单式进程查看与结束" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ToolSpace" Grid.Row="1" Grid.Column="2" Click="OnToolClick" Tag="space"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12"
                        CornerRadius="12" Background="{ThemeResource TaoCardBrush}"
                        BorderBrush="{ThemeResource TaoLineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="磁盘空间分析" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock Text="目录树式空间地图" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ToolSysInfo" Grid.Row="1" Grid.Column="3" Click="OnToolClick" Tag="sysinfo"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12"
                        CornerRadius="12" Background="{ThemeResource TaoCardBrush}"
                        BorderBrush="{ThemeResource TaoLineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="系统信息" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock Text="硬件配置一屏尽览" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ToolRecover" Grid.Row="2" Grid.Column="0" Click="OnToolClick" Tag="recover"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,12"
                        CornerRadius="12" Background="{ThemeResource TaoCardBrush}"
                        BorderBrush="{ThemeResource TaoLineSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                        <TextBlock Text="误删恢复" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TaoInkBrush}" />
                        <TextBlock Text="先镜像后找回，源盘零写入（R-P10-5）" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 状态与结果区（点击卡片后展开；未扫描如实显示） -->
            <TextBlock x:Name="ToolStatus" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource TaoInk3Brush}"
                       Text="点上面的卡片开始；扫描与处理通道随运行期接线启用。" />

            <Border x:Name="LargeResult" CornerRadius="14" BorderThickness="1" Padding="18,14" Visibility="Collapsed"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}" Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="大文件与空文件夹" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}" />
                    <TextBlock x:Name="LargeSummary" FontSize="12" Foreground="{ThemeResource TaoInk2Brush}" />
                    <ListView x:Name="LargeItems" MaxHeight="260" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ToolItemRow">
                                <Grid ColumnSpacing="10" Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind PathText}" FontSize="12" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" FontSize="12" FontWeight="Bold"
                                               Foreground="{ThemeResource TaoAzureDeepBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TaoInk3Brush}"
                               Text="处理前逐条过确认闸门；默认进回收站，可还原。" />
                </StackPanel>
            </Border>

            <Border x:Name="SpaceResult" CornerRadius="14" BorderThickness="1" Padding="18,14" Visibility="Collapsed"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}" Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="磁盘空间地图（目录 Top-N）" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}" />
                    <TextBlock x:Name="SpaceSummary" FontSize="12" Foreground="{ThemeResource TaoInk2Brush}" />
                    <ListView x:Name="SpaceItems" MaxHeight="260" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ToolItemRow">
                                <Grid ColumnSpacing="10" Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind PathText}" FontSize="12" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" FontSize="12" FontWeight="Bold"
                                               Foreground="{ThemeResource TaoAzureDeepBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border x:Name="DupResult" CornerRadius="14" BorderThickness="1" Padding="18,14" Visibility="Collapsed"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}" Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="重复文件" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}" />
                    <TextBlock x:Name="DupSummary" FontSize="12" Foreground="{ThemeResource TaoInk2Brush}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TaoInk3Brush}"
                               Text="同名同尺寸同哈希才判重；清理前逐组确认，保留份不动。" />
                </StackPanel>
            </Border>

            <Border x:Name="CtxResult" CornerRadius="14" BorderThickness="1" Padding="18,14" Visibility="Collapsed"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}" Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="右键菜单管理" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}" />
                    <TextBlock Text="禁用=可逆（键改名不删除），点「启用」随时还原；列出的都是本机真实条目。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    <ScrollViewer MaxHeight="280">
                        <ItemsControl x:Name="CtxList" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border x:Name="ShredResult" CornerRadius="14" BorderThickness="1" Padding="18,14" Visibility="Collapsed"
                    BorderBrush="{ThemeResource TaoLineSoftBrush}" Background="{ThemeResource TaoCardBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="文件粉碎" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TaoInkBrush}" />
                    <TextBlock x:Name="ShredSummary" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TaoInk2Brush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ShredPickButton" Content="选择文件…" Click="OnShredPick" />
                        <Button x:Name="ShredRunButton" Content="开始粉碎" Click="OnShredRun" IsEnabled="False" />
                        <Button x:Name="ShredCancelButton" Content="取消" Click="OnShredCancel" IsEnabled="False" />
                        <Button x:Name="ShredRestoreButton" Content="从快照还原…" Click="OnShredRestore" />
                        <Button x:Name="ShredPurgeButton" Content="清除到期快照" Click="OnShredPurge" />
                    </StackPanel>
                    <ProgressBar x:Name="ShredProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    <ListView x:Name="ShredItems" MaxHeight="260" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ToolItemRow">
                                <Grid ColumnSpacing="10" Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind PathText}" FontSize="12" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TaoInkBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" FontSize="12" FontWeight="Bold"
                                               Foreground="{ThemeResource TaoAzureDeepBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock FontSize="12" Foreground="{ThemeResource TaoInk3Brush}" TextWrapping="Wrap"
                               Text="粉碎前逐份快照落盘（快照失败该份不碎），保留 7 天内可从快照还原；到期物理清除前会再次确认。系统关键目录内的文件不可选。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
