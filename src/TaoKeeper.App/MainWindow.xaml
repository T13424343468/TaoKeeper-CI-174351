<?xml version="1.0" encoding="utf-8"?>
<!--
    主窗（道系骨架，布局严格对齐原型 v19）：
    左侧 260px 导航栏（13 页按 AppRouteCatalog 顺序，单字「 glyph + 中文名」，底部合规注脚），
    右侧内容 Frame 按路由切页。三主题经 TaoTheme.* 资源字典即时换肤。
    页面注册表见 PageRegistry：已落地页直接导航，未落地页显示如实占位（不假数据）。
-->
<Window
    x:Class="TaoKeeper.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaoKeeper.App">

    <Grid Background="{ThemeResource TaoPaperBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航：道系单字 glyph + 页名（顺序=原型 v19，交付版无「设计说明」） -->
        <Grid Grid.Column="0" Background="{ThemeResource TaoAzureWashBrush}" Padding="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="18,0,18,14">
                <TextBlock Text="道管家 · TaoKeeper" FontSize="17" FontWeight="SemiBold"
                           Foreground="{ThemeResource TaoInkBrush}" />
                <TextBlock Text="清理经你确认 · 默认进回收站" FontSize="11.5" Margin="0,4,0,0"
                           Foreground="{ThemeResource TaoInk3Brush}" />
            </StackPanel>

            <ListView x:Name="NavList" Grid.Row="1" Margin="10,0,10,0"
                      SelectionMode="Single" IsItemClickEnabled="False"
                      SelectionChanged="OnNavSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:NavItem">
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="8,7,8,7">
                            <Border Width="30" Height="30" CornerRadius="8"
                                    Background="{ThemeResource TaoAzureBrush}">
                                <TextBlock Text="{x:Bind Glyph}" FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="White" />
                            </Border>
                            <TextBlock Text="{x:Bind Title}" FontSize="14" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TaoInkBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Grid.Row="2" Margin="16,10,16,16" TextWrapping="Wrap" FontSize="12" LineHeight="20"
                       Foreground="{ThemeResource TaoInk3Brush}"
                       Text="清理动作全部经你确认，默认进回收站；软件只装官方源，装前校验、装后可溯。" />
        </Grid>

        <!-- 内容区：按路由切页 -->
        <Frame x:Name="ContentFrame" Grid.Column="1" Background="{ThemeResource TaoPaperBrush}" />
    </Grid>
</Window>
