<Application
    x:Class="TaoKeeper.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        道系三主题资源（水墨/天青/墨白），启动与切换见 AppTheme；色值与原型 v19 严格对齐。
        WinUI 库级控件（如 ProgressBar）的默认模板引用 XamlControlsResources 提供的库级
        主题资源键（实测缺失时报 XamlParseException: Cannot find a Resource with the
        Name/Key TabViewButtonBackground，MemPage 为首个触发页，r21 NAVLOG 实证）。
        故按 WinUI 3 标准合并 XamlControlsResources，且置于自研主题之前——合并字典按
        "后者优先"解析，TaoTheme.* 排在其后即可覆盖同名键。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- R-4/C4：按钮四态统一（主按钮/次按钮/危险按钮/幽灵按钮）——圆角/挂色收口，散写归档 -->
            <Style x:Key="TaoButtonPrimary" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource TaoAzureBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style x:Key="TaoButtonGhost" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="TaoButtonRed" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{ThemeResource TaoCinnabarBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/TaoTheme.Shuimo.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
