<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinUI3 应用壳（原型 v19 为唯一 UI 基线，见 TaoKeeper道系高保真原型.html）。
    沙箱（Linux）不构建本工程：WindowsAppSDK 包引用保持注释态（真机构建前取消注释），
    EnableWindowsTargeting 使 Linux 侧可做结构还原探测（真机无影响）；三测试工程与 Harness 照常。
    真机用 Visual Studio 2022 + Windows App SDK 1.5+ 构建运行，界面验证留完整包真机环节。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>TaoKeeper.App</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdents>win-x86;win-x64;win-arm64</RuntimeIdents>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 真机构建前取消下行注释（Windows App SDK）：
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240428000" /> -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaoKeeper.Core\TaoKeeper.Core.csproj" />
    <ProjectReference Include="..\TaoKeeper.AppKernel\TaoKeeper.AppKernel.csproj" />
  </ItemGroup>

</Project>
