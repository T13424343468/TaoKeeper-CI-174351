<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Windows 适配层（winget 软件源 / WUA+pnputil 驱动）。
      全部用进程调用 + 纯 .NET 解析，不引 Windows 专属包，沙箱（Linux）可编译可测试；
      真实进程只在 Windows 运行，非 Windows 运行时报红不静默跳过（互操作规则同 Core 互操作）。
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaoKeeper.Core\TaoKeeper.Core.csproj" />
    <!-- 启动项适配器（P5/P4）编译所需：注册表 Run 键与事件日志开机耗时读数；
         均为可还原包引用（沙箱缓存可用），运行期动作仍只在 Windows 真机生效 -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="4.7.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
  </ItemGroup>

</Project>
